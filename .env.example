# CANOPY environment. Copy to apps/web/.env.local for the web app.
# Never put private keys or paid API keys in NEXT_PUBLIC_ variables: they are sent to every browser.

# demo | local | live. Demo shows labelled fixtures and disables all writes.
NEXT_PUBLIC_CANOPY_MODE=demo
# elysium | elysium-testnet | local
NEXT_PUBLIC_CANOPY_NETWORK=elysium

# Brand and background media (paths under apps/web/public, or full https URLs)
NEXT_PUBLIC_BRAND_NAME=CANOPY
NEXT_PUBLIC_BG_WEBM=/media/jungle.webm
NEXT_PUBLIC_BG_MP4=/media/jungle.mp4
NEXT_PUBLIC_BG_POSTER=/media/jungle-poster.webp
# The footage is already slowed to half speed; 0.75 slows it further (default).
NEXT_PUBLIC_BG_PLAYBACK_RATE=0.75

# RPC endpoints. Use an origin-restricted browser key, or route reads through a protected proxy.
# Template: https://elysium-mainnet.g.alchemy.com/v2/<api-key>
NEXT_PUBLIC_ELYSIUM_RPC_URL=
NEXT_PUBLIC_ELYSIUM_WS_URL=
NEXT_PUBLIC_ELYSIUM_TESTNET_RPC_URL=
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545

# Optional. WalletConnect stays disabled with a visible reason until this is set.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-side only (deploy scripts, indexer). Leave empty in this file.
DEPLOYER_PRIVATE_KEY=
ELYSIUM_RPC_URL_SERVER=
DATABASE_URL=
