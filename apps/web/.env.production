# Public production defaults (no secrets). Vercel environment variables override these.
# live = the real state of CANOPY on Elysium mainnet. Set NEXT_PUBLIC_CANOPY_MODE=demo to show labelled fixtures instead.
NEXT_PUBLIC_CANOPY_MODE=live
NEXT_PUBLIC_CANOPY_NETWORK=elysium
# Required for the live chain check. Add it in Vercel: your Alchemy or Chainstack Elysium mainnet
# endpoint, restricted to your site's domain in the provider dashboard.
# NEXT_PUBLIC_ELYSIUM_RPC_URL=
